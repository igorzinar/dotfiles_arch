{
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "mpris",
    "privacy",
    "custom/eye",
    "tray",
    "hyprland/language",
    "keyboard-state",
    "network",
    "group/brightness",
    "pulseaudio",
    "battery",
    "power-profiles-daemon",
    "group/hardware",
    "clock"
  ],

  // --- Hardware drawer: CPU always visible, hover reveals RAM / disk / GPU.
  // Turns peach at warning and red at critical load, so you notice without hovering.
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "hardware-child",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu", // always visible
      "memory",
      "custom/disk",
      "custom/gpu"
    ]
  },

  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "nodes": [
      {
        "type": "audio-in",
        "icons": {
          "device": " 󰍬"
        }
      },
      {
        "type": "screenshare",
        "icons": {
          "device": " 󰧔"
        }
      }
    ]
  },
  "custom/disk": {
    "interval": 60,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/disk.sh",
    "format": "<span size='13000' foreground='#f38ba8'>󰋊  </span>{}",
    "on-click": "kitty -e yazi ~/"
  },

  "clock": {
    "format": "<span foreground='#f5c2e7'>   </span>{:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000' foreground='#a6e3a1'>{icon} </span> {capacity}%",
    "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {capacity}%",
    "format-critical": "<span size='13000' foreground='#E38C8F'>{icon} </span> {capacity}%",
    "format-charging": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-plugged": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {time}",
    "format-full": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}"
  },
  // Power profile (needs power-profiles-daemon running). Click: cycle profiles.
  "power-profiles-daemon": {
    "format": "<span size='13000'>{icon}</span>",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}\n\nClick: next profile",
    "tooltip": true,
    "format-icons": {
      "default": "󰾅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },
  "network": {
    "format-wifi": "<span size='13000' foreground='#f5e0dc'>   </span>{essid}",
    "format-ethernet": "<span size='13000' foreground='#f5e0dc'>󰤭   </span> Disconnected",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "<span size='13000' foreground='#f5e0dc'>   </span>Disconnected",
    "tooltip-format-wifi": "Signal Strenght: {signalStrength}%"
  },
  // --- Brightness drawer: icon+% always visible, slider slides out on hover ---
  "group/brightness": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "brightness-slider",
      "transition-left-to-right": false
    },
    "modules": [
      "backlight", // always visible: icon + percentage
      "backlight/slider" // revealed on hover
    ]
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "<span size='13000' foreground='#f9e2af'>{icon} </span>{percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%\nScroll or drag the slider to adjust",
    "scroll-step": 5,
    "on-scroll-up": "brightnessctl -d intel_backlight set +5%",
    "on-scroll-down": "brightnessctl -d intel_backlight set 5%-"
  },

  "backlight/slider": {
    "device": "intel_backlight",
    "min": 5,
    "max": 100,
    "orientation": "horizontal"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "max-volume": 150,
    "scroll-step": 5,
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "hyprland/language": {
    "format": "  {} ",
    "format-ru": "RU",
    "format-en": "US"
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "cpu": {
    "interval": 3,
    "format": "<span size='13000' foreground='#fab387'>  </span>{usage}%",
    "states": { "warning": 70, "critical": 90 },
    "tooltip-format": "CPU: {usage}%   Load: {load}\nHover: RAM / disk / GPU\nClick: btop",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "<span size='13000' foreground='#94e2d5'>  </span>{percentage}%",
    "states": { "warning": 80, "critical": 90 },
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB\nClick: btop",
    "on-click": "kitty -e btop"
  },

  "mpris": {
    "format": "<span size='13000' foreground='#cba6f7'>󰎈 </span>{artist} - {title}",
    "format-paused": "<span size='13000' foreground='#cba6f7'> </span>{artist} - {title}",
    "max-length": 20,
    "tooltip-format": "{player} | {status}\n{title}\n{artist} "
  },
  // One nvidia-smi call, skipped while the GPU sleeps (see scripts/gpu.sh)
  "custom/gpu": {
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "format": "<span size='13000' foreground='#89b4fa'>󰾲  </span>{}",
    "on-click": "kitty -e nvtop"
  },

  "custom/eye": {
    "format": "<span size='13000' foreground='#fab387'>{icon}</span>",
    "format-icons": ["󰛨"],
    "tooltip": true,
    "tooltip-format": "ЛКМ: 5000K (Комфорт)\nПКМ: Выключить защиту\n\nНе забывай капать Hylo Comod!",
    "on-click": "pkill hyprsunset; hyprsunset --temperature 5000K",
    "on-click-right": "pkill hyprsunset",
    "interval": "once"
  }
}
